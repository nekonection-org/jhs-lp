# NEXT_PUBLIC_ で始まる値はブラウザへ公開されます。
# 本番環境では、実際に管理している公開URLだけを設定してください。
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DISCORD_INVITE_URL=
NEXT_PUBLIC_RUST_SERVER_ADDRESS=
NEXT_PUBLIC_TEBEX_URL=
NEXT_PUBLIC_MODERATOR_APPLICATION_URL=

# ローカル開発では DATABASE_PASSWORD を使用できます。
# Docker Composeではこの値を使わず、secrets/mysql-passwordを読み込みます。
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=jhs_app
DATABASE_PASSWORD=
DATABASE_NAME=jhs

# Cloudflare AccessのSelf-hosted applicationで発行された値を設定します。
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=
ADMIN_ALLOWED_EMAILS=

# 開発環境でのみ利用できる認証バイパスです。本番では必ずfalseにします。
ADMIN_DEV_BYPASS=false
ADMIN_DEV_EMAIL=

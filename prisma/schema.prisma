generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "mysql"
}

enum AnnouncementCategory {
  NOTICE      @map("notice")
  MAINTENANCE @map("maintenance")
  UPDATE      @map("update")
  EVENT       @map("event")
  IMPORTANT   @map("important")
  INCIDENT    @map("incident")
}

enum AnnouncementStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")
}

enum AnnouncementLocale {
  JA @map("ja")
  EN @map("en")
}

enum AuditAction {
  CREATE  @map("create")
  UPDATE  @map("update")
  ARCHIVE @map("archive")
}

enum FaqStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")
}

enum FaqContentStatus {
  CONFIRMED @map("confirmed")
  PENDING   @map("pending")
}

enum FaqLocale {
  JA @map("ja")
  EN @map("en")
}

model Announcement {
  id           String                    @id @default(uuid()) @db.Char(36)
  category     AnnouncementCategory
  status       AnnouncementStatus        @default(DRAFT)
  publishedAt  DateTime?                 @map("published_at") @db.DateTime(3)
  externalUrl  String?                   @map("external_url") @db.VarChar(2048)
  version      Int                       @default(1)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  translations AnnouncementTranslation[]
  auditLogs    AuditLog[]

  @@index([status, publishedAt], map: "announcement_publication_idx")
  @@index([updatedAt], map: "announcement_updated_at_idx")
  @@map("announcements")
}

model AnnouncementTranslation {
  announcementId String             @map("announcement_id") @db.Char(36)
  locale         AnnouncementLocale
  title          String             @db.VarChar(160)
  description    String             @db.VarChar(600)
  createdAt      DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  announcement   Announcement       @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, locale])
  @@map("announcement_translations")
}

model FaqItem {
  id            String           @id @default(uuid()) @db.Char(36)
  status        FaqStatus        @default(DRAFT)
  contentStatus FaqContentStatus @default(CONFIRMED) @map("content_status")
  sortOrder     Int              @map("sort_order")
  version       Int              @default(1)
  createdAt     DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  translations  FaqTranslation[]
  auditLogs     AuditLog[]

  @@index([status, sortOrder], map: "faq_publication_order_idx")
  @@index([updatedAt], map: "faq_updated_at_idx")
  @@map("faq_items")
}

model FaqTranslation {
  faqItemId String    @map("faq_item_id") @db.Char(36)
  locale    FaqLocale
  question  String    @db.VarChar(240)
  answer    String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  faqItem   FaqItem   @relation(fields: [faqItemId], references: [id], onDelete: Cascade)

  @@id([faqItemId, locale])
  @@map("faq_translations")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Char(36)
  announcementId String?       @map("announcement_id") @db.Char(36)
  faqItemId      String?       @map("faq_item_id") @db.Char(36)
  action         AuditAction
  actorSub       String        @map("actor_sub") @db.VarChar(255)
  actorEmail     String        @map("actor_email") @db.VarChar(320)
  requestId      String?       @map("request_id") @db.VarChar(128)
  beforeData     Json?         @map("before_data")
  afterData      Json?         @map("after_data")
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  faqItem        FaqItem?      @relation(fields: [faqItemId], references: [id], onDelete: SetNull)

  @@index([createdAt], map: "audit_log_created_at_idx")
  @@index([announcementId, createdAt], map: "audit_log_announcement_idx")
  @@index([faqItemId, createdAt], map: "audit_log_faq_item_idx")
  @@map("audit_logs")
}
